{
  "name": "confirm-first-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A chat agent for a B2B project app that can act, but never writes without a human click.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "demo": "tsx scripts/reset-db.ts && next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx evals/run.ts",
    "eval:live": "AGENT_MODE=anthropic tsx evals/run.ts --live",
    "mcp": "tsx mcp/server.ts",
    "confirm": "tsx mcp/confirm-cli.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "audit:verify": "tsx scripts/audit-verify.ts",
    "attack": "tsx attacks/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
