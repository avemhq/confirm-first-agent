# Copy to .env.local. Everything is optional: without a key the app runs on the scripted mock model.
# AGENT_MODE=mock            # mock | anthropic (default: anthropic if ANTHROPIC_API_KEY is set)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# CONFIRM_SECRET=            # >= 32 bytes; default: random, stored in .data/confirm.secret
# MOCK_ADVERSARIAL=1         # web demo default 1: mock obeys injections so you can watch the server refuse
# DB_PATH=.data/demo.db
